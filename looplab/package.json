{
  "name": "looplab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A playable prompt experiment lab with fixed tests and visible evidence.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "cf:typegen": "wrangler types --include-runtime=false",
    "test": "vitest run",
    "test:browser": "tsx scripts/browser-check.ts",
    "test:live": "tsx scripts/live-check.ts",
    "eval": "tsx scripts/evaluate.ts",
    "check": "npm run typecheck && npm test && npm run eval && npm run build && wrangler deploy --dry-run",
    "db:local": "wrangler d1 migrations apply looplab-db --local",
    "db:remote": "wrangler d1 migrations apply looplab-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260904.1",
    "@types/node": "^26.4.1",
    "@types/three": "^0.183.1",
    "@playwright/test": "^1.58.0",
    "@axe-core/playwright": "^4.11.0",
    "miniflare": "5.20260903.0-alpha",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "tsx": "^4.20.0",
    "wrangler": "4.129.0"
  }
}
