{
  "name": "airframe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-camera gesture workspace: point, pinch, and move ideas in the air.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --port 8791",
    "prepare:vision": "tsx scripts/prepare-vision.ts",
    "cf:typegen": "wrangler types --include-runtime=false",
    "typecheck": "tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:browser": "tsx scripts/browser-check.ts",
    "build": "npm run prepare:vision && vite build",
    "check": "npm run cf:typegen && npm run typecheck && npm test && npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": { "@mediapipe/tasks-vision": "1.0.1", "three": "0.185.1" },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260904.1",
    "@types/node": "^26.4.1",
    "@types/three": "^0.183.1",
    "@playwright/test": "^1.58.0",
    "@axe-core/playwright": "^4.11.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "tsx": "^4.20.0",
    "wrangler": "4.129.0"
  }
}
