{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src/worker.ts", "src/server/**/*.ts", "src/shared/**/*.ts", "tests/worker.test.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "dist"]
}
