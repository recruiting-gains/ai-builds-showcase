{
  "name": "ai-workflow-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Two beginner-friendly AI workflows on Cloudflare Workers and Workers AI.",
  "scripts": {
    "cf-typegen": "wrangler types",
