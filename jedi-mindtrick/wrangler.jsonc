{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jedi-mindtrick", "main": "worker/index.ts", "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "RENDER_LEDGER", "class_name": "RenderLedger" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RenderLedger"] }],
  "vars": { "AI_RENDER_ENABLED": "true" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
